                    <div class="at-search-top d-flex justify-content-between align-items-center">
                        <div class="at-header-logo at-search-logo">
                            <a href="/">
                                <img data-width="30" src="/assets/imgs/template/logo/favicon.svg" alt="Vuriko Studio">
                                <p class="h6 fw-700 fz-24 mb-0">Vuriko</p>
                            </a>
                        </div>
                        <button class="at-search-close" aria-label="Tutup pencarian">
                            <i class="fa-light fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="at-search-form">
