---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Vuriko Studio — Solusi Enterprise, Cloud & AI";
const description = "Arsitektur sistem enterprise, aplikasi kustom, infrastruktur hosting aman, dan AI Agent untuk perusahaan.";
const styles = ["/assets/css/vendors/carouselTicker.css", "/assets/css/vendors/bootstrap.min.css", "/assets/css/vendors/swiper-bundle.min.css", "/assets/css/vendors/nice-select.css", "/assets/css/vendors/font-awesome-pro.css", "/assets/css/vendors/magnific-popup.css", "/assets/css/vendors/odometer.css", "/assets/css/vendors/spacing.css", "/assets/css/main.css"];
const scripts = ["/assets/js/vendors/color-modes.js", "/assets/js/vendors/jquery-3.7.1.min.js", "/assets/js/vendors/plugin.js", "/assets/js/vendors/bootstrap.min.js", "/assets/js/vendors/swiper-bundle.min.js", "/assets/js/vendors/jquery.carouselTicker.min.js", "/assets/js/vendors/jquery.magnific-popup.min.js", "/assets/js/vendors/jquery.odometer.min.js", "/assets/js/vendors/jquery.appear.js", "/assets/js/vendors/jquery.elevatezoom.js", "/assets/js/vendors/nice-select.js", "/assets/js/vendors/parallax.js", "/assets/js/vendors/ripple-2.js", "/assets/js/vendors/imagesloaded-pkgd.js", "/assets/js/vendors/isotope.pkgd.min.js", "/assets/js/vendors/image-hover-effects.js", "/assets/js/at-cursor.js", "/assets/js/main.js"];
